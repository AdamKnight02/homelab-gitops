# =============================================================================
# AWS Terraform Variables — Example File
# =============================================================================
# Copy this file to terraform.tfvars and customize values.
# NEVER commit terraform.tfvars (it is gitignored).
# =============================================================================

# --- AWS Authentication ---
# aws_region  = "us-east-1"
# aws_profile = "default"

# --- Resource Naming ---
# name_prefix = "pki"

# --- Compute ---
# aws_instance_type     = "t3.micro"
# aws_root_volume_size  = 20
# aws_root_volume_type  = "gp3"

# --- Networking ---
# aws_vpc_cidr    = "10.0.0.0/16"
# aws_subnet_cidr = "10.0.1.0/24"

# --- SSH Access ---
# WARNING: Only enable SSH from known IPs. Empty = no inbound SSH.
# allow_ssh_cidr = ["203.0.113.0/24"]

# --- Public IP ---
# WARNING: Public IPs incur cost ($3.60/month as of Feb 2024) and increase attack surface.
# aws_associate_public_ip = false

# --- IAM ---
# aws_create_iam_role = true

# --- K3s / Argo CD ---
# k3s_version         = "v1.30"
# argocd_version      = "v2.12"
# git_repo_url        = "https://github.com/AdamKnight02/homelab-gitops.git"
# git_target_revision = "main"

# --- PKI ---
# trust_domain = "cloudlab.local"

# --- Service Tier ---
# service_tier = "economy"  # economy | standard | enterprise
# enable_eks   = false       # EKS instead of K3s (enterprise only)
# aws_instance_type_override = ""  # Override tier-default instance type
