{
  "workflow": ".github/workflows/azure-deploy-customer.yml",
  "triggers": [
    "workflow_dispatch"
  ],
  "jobs": [
    {
      "name": "Validate Configuration",
      "id": "validate",
      "runs-on": "ubuntu-latest",
      "outputs": {
        "validation_status": "${{ steps.validate.outputs.status }}"
      }
    },
    {
      "name": "Terraform Plan",
      "id": "plan",
      "needs": [
        "validate"
      ],
      "runs-on": "ubuntu-latest",
      "outputs": {
        "plan_exit_code": "${{ steps.plan.outputs.exit_code }}",
        "plan_has_changes": "${{ steps.plan.outputs.has_changes }}"
      }
    },
    {
      "name": "Manual Approval",
      "id": "approval",
      "needs": [
        "plan"
      ],
      "runs-on": "ubuntu-latest",
      "if": "github.event.inputs.operation == 'deploy'",
      "environment": {
        "name": "${{ github.event.inputs.environment }}"
      }
    },
    {
      "name": "Deploy Infrastructure",
      "id": "deploy-infrastructure",
      "needs": [
        "approval"
      ],
      "runs-on": "ubuntu-latest",
      "if": "github.event.inputs.operation == 'deploy' || github.event.inputs.operation == 'destroy'"
    },
    {
      "name": "Deploy Platform",
      "id": "deploy-platform",
      "needs": [
        "deploy-infrastructure"
      ],
      "runs-on": "ubuntu-latest",
      "if": "github.event.inputs.operation == 'deploy'"
    },
    {
      "name": "Smoke Tests",
      "id": "smoke-tests",
      "needs": [
        "deploy-platform"
      ],
      "runs-on": "ubuntu-latest",
      "if": "github.event.inputs.operation == 'deploy'"
    },
    {
      "name": "Generate Report",
      "id": "report",
      "needs": [
        "validate",
        "plan",
        "approval",
        "deploy-infrastructure",
        "deploy-platform",
        "smoke-tests"
      ],
      "runs-on": "ubuntu-latest",
      "if": "always()"
    }
  ],
  "action_refs": [
    {
      "name": "actions/checkout",
      "version": "v4"
    },
    {
      "name": "azure/login",
      "version": "v2"
    },
    {
      "name": "hashicorp/setup-terraform",
      "version": "v3"
    },
    {
      "name": "actions/upload-artifact",
      "version": "v4"
    },
    {
      "name": "actions/download-artifact",
      "version": "v4"
    }
  ],
  "script_refs": [
    {
      "path": ".github/scripts/init-azure-backend.sh",
      "exists": false
    }
  ],
